# Copie para .env e preencha. Nunca versione o arquivo .env.
# Em produção (NODE_ENV=production) o servidor NÃO sobe sem FRONTEND_URL,
# APP_ACCESS_TOKEN e DATABASE_URL.
NODE_ENV=development
PORT=3000

# Endereço do PostgreSQL (Render Postgres ou Neon)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/foco_do_dia
# TLS do banco: verify (padrão fora do localhost), disable (só local) ou no-verify (excepcional)
DB_SSL=

# Domínios do frontend autorizados (CORS), separados por vírgula
FRONTEND_URL=http://localhost:5173

# Código de acesso do app (mínimo 12 caracteres). A pessoa digita uma vez no app.
APP_ACCESS_TOKEN=

# Fuso horário dos turnos
TZ_APP=America/Sao_Paulo

# Chave da API de IA (opcional: sem ela, o relatório aparece sem sugestões)
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
