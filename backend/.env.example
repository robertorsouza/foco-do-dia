# Copie para .env e preencha. Nunca versione o arquivo .env.
PORT=3000
# Endereço do PostgreSQL (Render Postgres ou Neon)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/foco_do_dia
# Domínio do frontend autorizado a chamar a API (CORS)
FRONTEND_URL=http://localhost:5173
# Fuso horário dos turnos
TZ_APP=America/Sao_Paulo
# Chave da API de IA (opcional: sem ela, o relatório aparece sem sugestões)
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
